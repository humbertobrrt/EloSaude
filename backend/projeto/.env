# Copie para .env (ou configure no IntelliJ/VS Code/servidor de deploy).
# NÃO versione o .env: adicione ".env" ao .gitignore.

# --- Supabase (Supabase > Connect) ---
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.REF_DO_PROJETO
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# --- Segurança ---
JWT_SECRET=gere-com-openssl-rand-base64-48
JWT_EXPIRATION_MINUTES=120

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- WhatsApp / Twilio (opcional) ---
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Outros ---
JPA_SHOW_SQL=false